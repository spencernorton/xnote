<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>tech.norvi.xnote</id>
  <launchable type="desktop-id">xnote.desktop</launchable>
  <name>XNote</name>
  <summary>Sticky notes that stay on your desktop</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="tech.norvi">
    <name>Spencer Norton</name>
  </developer>
  <description>
    <p>XNote keeps each note as its own small window on the desktop: sized and coloured on its own, with the first line as its title. There is no list to open first. Every change is saved as you type, and nothing leaves the machine unless you ask it to.</p>
    <p>Notes are plain files under ~/.config/xnote. Hover a note for a small toolbar, right-click for the menu, and use the keyboard for the rest: Ctrl+N for a new note, Ctrl+B, Ctrl+I and Ctrl+U for formatting, Ctrl+F to search inside a note.</p>
    <ul>
      <li>Independent note windows with a classic six-colour sticky-note palette, or any colour and font you choose, per note or for all of them</li>
      <li>Autosave a few seconds after every edit; a failed write is retried, never silently dropped</li>
      <li>An optional StatusNotifierItem tray icon with a menu of all notes</li>
      <li>Optional encrypted backups with the xnote-cloud-backup helper: local snapshots, an rclone or filesystem remote, and a recovery code for a new machine</li>
      <li>Native Wayland with libadwaita styling; notes from Xpad are migrated on first start</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/spencernorton/xnote</url>
  <url type="bugtracker">https://github.com/spencernorton/xnote/issues</url>
  <url type="vcs-browser">https://github.com/spencernorton/xnote</url>
  <url type="help">https://github.com/spencernorton/xnote/blob/main/docs/user-guide.md</url>
  <url type="donation">https://buy.stripe.com/8x26oH2U44f65TRe574wM04</url>
  <translation type="gettext">xnote</translation>
  <content_rating type="oars-1.1"/>
  <keywords>
    <keyword>notes</keyword>
    <keyword>sticky</keyword>
    <keyword>postit</keyword>
    <keyword>xpad</keyword>
  </keywords>
  <provides>
    <binary>xnote</binary>
    <binary>xnote-cloud-backup</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <caption>Five sticky notes of different colours and sizes on a desktop</caption>
      <image type="source" width="1280" height="800">https://raw.githubusercontent.com/spencernorton/xnote/main/screenshots/xnote-desktop.png</image>
    </screenshot>
    <screenshot>
      <caption>The floating toolbar that appears when a note is hovered</caption>
      <image type="source" width="1280" height="800">https://raw.githubusercontent.com/spencernorton/xnote/main/screenshots/xnote-toolbar.png</image>
    </screenshot>
    <screenshot>
      <caption>The sticky-note colour palette</caption>
      <image type="source" width="640" height="666">https://raw.githubusercontent.com/spencernorton/xnote/main/screenshots/xnote-color-picker.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences, View page: toolbar, scrollbar and window decorations</caption>
      <image type="source" width="640" height="666">https://raw.githubusercontent.com/spencernorton/xnote/main/screenshots/xnote-preferences-view.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences, Layout page: font, colours and the default note size</caption>
      <image type="source" width="640" height="666">https://raw.githubusercontent.com/spencernorton/xnote/main/screenshots/xnote-preferences-layout.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="3.3.2" date="2026-10-28">
      <description><p>Keep tray menus responsive and make hybrid-key escrow, recovery and key rotation fail safely across interrupted operations.</p></description>
    </release>
    <release version="3.3.1" date="2026-10-28">
      <description>
        <p>Fix Google Drive sign-in validation with encrypted rclone configs.</p>
      </description>
    </release>
    <release version="3.3.0" date="2026-10-28">
      <description>
        <p>Post-quantum hybrid backups (ML-KEM-1024), dual Drive/Dropbox targets, one-click test recovery with a monthly drill, escrow key download, and true master-key rotation in Preferences.</p>
      </description>
    </release>
    <release version="3.2.6" date="2026-10-27">
      <description>
        <p>Map restored notes quietly on startup without sending focus-stealing activation requests across workspaces, and disable desktop startup notification so the dock icon does not bounce or cycle workspaces on login.</p>
      </description>
    </release>
    <release version="3.2.5" date="2026-10-27">
      <description>
        <p>Add a Backup page to XNote Preferences with target selection (Local Only, Google Drive, Dropbox, or custom path/remote), one-click browser OAuth sign-in, in-app end-to-end encryption setup/unlock/passphrase rotation, manual backup trigger, and hourly timer control.</p>
      </description>
    </release>
    <release version="3.2.4" date="2026-10-26">
      <description>
        <p>End-to-end encrypted backup verification for Dropbox, Google Drive and rclone crypt remotes, unchanged-note sync deduplication, systemd user unit activation on autosave, and GTK 4 / GObject memory and signal fixes.</p>
      </description>
    </release>
    <release version="3.2.3" date="2026-09-29">
      <description>
        <p>Notes open in the order of their file names, so the XNote Placement extension keeps notes that share a first line each in its own place.</p>
      </description>
    </release>
    <release version="3.2.0" date="2026-09-21">
      <description>
        <p>The package recommends the XNote Placement extension; README and community files in the NorviTech Suite house style, with an encrypted-backup callout.</p>
      </description>
    </release>
    <release version="3.1.0" date="2026-09-20">
      <description>
        <p>Debian package built from the public tree and published to the APT archive; a full user guide and development notes; restore works after a normal quit; the startup "open a new empty pad" no longer fires on remote commands.</p>
      </description>
    </release>
    <release version="3.0.6" date="2026-09-20">
      <description>
        <p>README leads with the product: a session recording, desktop and toolbar captures, and preference screenshots from an isolated profile.</p>
      </description>
    </release>
    <release version="3.0.5" date="2026-09-19">
      <description>
        <p>Renamed the public README so GitHub renders its screenshots and animations on the repository overview page.</p>
      </description>
    </release>
    <release version="3.0.4" date="2026-09-19">
      <description>
        <p>Added privacy-reviewed screenshots and short animations for notes, preferences, colors, and resizing.</p>
      </description>
    </release>
    <release version="3.0.3" date="2026-09-19">
      <description>
        <p>Prepared the first audited public source release, with public documentation, provenance, metadata, and reproducible release checks.</p>
      </description>
    </release>
    <release version="2.0.0" date="2026-07-14">
      <description>
        <p>Full rename from Xpad to XNote: new binary (xnote), package name, config directory (~/.config/xnote), icons, and desktop integration. Existing notes are automatically migrated from ~/.config/xpad on first launch. The package replaces the old xpad package.</p>
      </description>
    </release>
    <release version="1.5.0" date="2026-07-11">
      <description>
        <p>Backup pipeline heartbeat and hardening, honest save-error handling, tray watcher re-registration with a properly themable symbolic icon, and packaging fixes (deb epoch, renderer pin moved into the binary, autostart as a symlink).</p>
      </description>
    </release>
    <release version="1.3.0" date="2026-06-11">
      <description>
        <p>Right-clicking a note now shows xpad's own menu (with Close) instead of the text widget's built-in one, and Close is also available while text is selected.</p>
      </description>
    </release>
    <release version="1.2.0" date="2026-06-10">
      <description>
        <p>New pads now pick a random classic sticky-note color (toggleable in Preferences), and the Preferences Close button works again.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-06-10">
      <description>
        <p>The pad toolbar is now a floating rounded pill that fades in over the note on hover, with symbolic icons and a corner resize grip.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-06-09">
      <description>
        <p>First XNote release: ported from GTK 3 to GTK 4 and libadwaita, with a StatusNotifierItem tray and a symbolic top-bar icon.</p>
      </description>
    </release>
  </releases>
</component>
